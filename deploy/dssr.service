[Unit]
Description=dssr discovery service
Wants=network-online.target
After=network-online.target

[Service]
User=dssr
Group=dssr
ExecStart=/usr/local/bin/dssr serve --config /etc/dssr/dssr.yaml
Restart=on-failure
RestartSec=10s
# /run/dssr holds admin.sock for the dssr group, /var/lib/dssr holds the index, and /var/log/dssr holds the search log
RuntimeDirectory=dssr
RuntimeDirectoryMode=0750
StateDirectory=dssr
StateDirectoryMode=0700
LogsDirectory=dssr
LogsDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# dssr needs no capability, no device, and no kernel interface; check the result with: systemd-analyze security dssr.service
CapabilityBoundingSet=
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX for admin.sock and DNS through nss, AF_INET and AF_INET6 for the HTTP API and the OAI-PMH sources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
